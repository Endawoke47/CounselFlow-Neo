# CounselFlow-Neo Environment Configuration Template
# Copy this file and rename to .env in the respective app directories
# Updated: 2025-07-26 Development Setup

# =================================
# DEVELOPMENT CONFIGURATION
# =================================

# Application (Development)
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="CounselFlow-Neo"

# API Configuration (Development)
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080
API_PORT=8080

# Database (Development - SQLite)
DATABASE_URL="file:./dev.db"

# AI Configuration - Add your actual API keys
NEXT_PUBLIC_AI_ENDPOINT=http://localhost:8080/api/ai
NEXT_PUBLIC_ENABLE_AI_FEATURES=true
OPENAI_API_KEY=your-openai-key-here
ANTHROPIC_API_KEY=your-anthropic-key-here
GOOGLE_API_KEY=your-google-key-here

# Security - Change these in production
JWT_SECRET=your-jwt-secret-here-change-in-production
NEXTAUTH_SECRET=your-nextauth-secret-here-change-in-production
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# Performance Configuration
NEXT_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=false
NEXT_PUBLIC_DEBUG=true

# Email Configuration
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password

# Logging
LOG_LEVEL=debug

# =================================
# PRODUCTION OVERRIDES
# =================================
# Uncomment and modify for production:

# NODE_ENV=production
# NEXT_PUBLIC_APP_URL=https://counselflow.com
# NEXT_PUBLIC_API_URL=https://api.counselflow.com
# DATABASE_URL=postgresql://counselflow:password@localhost:5432/counselflow
# NEXT_PUBLIC_DEBUG=false
# LOG_LEVEL=info
# NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0

# Security
JWT_SECRET=your-super-secure-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-min-32-chars
ENCRYPTION_KEY=your-32-character-encryption-key
CSRF_SECRET=your-csrf-secret

# Email (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@counselflow.com

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Stripe
STRIPE_SECRET_KEY=sk_live_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your-publishable-key

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=counselflow-documents

# Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
MIXPANEL_TOKEN=your-mixpanel-token
GRAFANA_PASSWORD=your-grafana-password

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4-turbo-preview
AI_MAX_TOKENS=4000

# Ollama
NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
OLLAMA_MODELS=initium/law_model,qwen2.5:7b,llama3.1:8b,mistral:7b
