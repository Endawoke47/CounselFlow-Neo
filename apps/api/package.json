{
  "name": "@counselflow/api",
  "version": "1.0.0",
  "description": "CounselFlow API Backend",
  "main": "dist/index.js",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/minimal-working-api.ts",
    "dev:real": "nodemon --watch src --ext ts --exec ts-node src/real-api.ts",
    "build": "tsc",
    "build:real": "tsc --outDir dist-real --include 'src/real-api.ts' 'src/services/real-*.ts' 'src/routes/real-*.ts' 'src/routes/auth-real.routes.ts' 'src/middleware/auth-new.middleware.ts'",
    "start": "node dist/index.js",
    "start:real": "node dist-real/real-api.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --passWithNoTests",
    "test:unit": "jest src/tests/unit",
    "test:integration": "jest src/tests/integration",
    "test:performance": "jest src/tests/performance",
    "test:resilience": "jest src/tests/unit/data-management-resilience.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "type-coverage": "tsc --noEmit --listFiles | wc -l",
    "clean": "rimraf dist dist-real",
    "prebuild": "npm run clean",
    "precommit": "npm run lint && npm run type-check && npm run test",
    "docker:build": "docker build -t counselflow-api .",
    "docker:run": "docker run -p 3001:3001 counselflow-api",
    "docker:dev": "docker-compose up --build",
    "health-check": "curl -f http://localhost:3001/health || exit 1",
    "logs:analyze": "node analyze-logs.js",
    "logs:tail": "tail -f logs/combined.log",
    "logs:errors": "tail -f logs/error.log",
    "logs:clear": "rm -rf logs/*.log",
    "logs:clear:win": "powershell -Command \"Remove-Item logs/*.log -ErrorAction SilentlyContinue\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.9.1",
    "@google-ai/generativelanguage": "^0.2.1",
    "@huggingface/hub": "^2.4.0",
    "@prisma/client": "^5.22.0",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.4",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^2.4.3",
    "chromadb": "^3.0.9",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "langchain": "^0.1.37",
    "llamaindex": "^0.11.17",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^7.0.5",
    "onnxruntime-node": "^1.22.0-rev",
    "openai": "^4.104.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.16.3",
    "prisma": "^5.22.0",
    "sharp": "^0.34.3",
    "tesseract.js": "^5.1.1",
    "winston": "^3.17.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jest": "^29.5.8",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.10",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "legal",
    "api",
    "counsel",
    "practice-management"
  ]
}
