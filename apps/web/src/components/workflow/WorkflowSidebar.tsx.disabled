interface WorkflowSidebarProps {
  onAddNode: (type: string, data: any) => void;
}

export function WorkflowSidebar({ onAddNode }: WorkflowSidebarProps) {
  const handleDragStart = (event: React.DragEvent, nodeType: string, nodeData: any) => {
    event.dataTransfer.setData('application/reactflow', nodeType);
    event.dataTransfer.setData('nodeData', JSON.stringify(nodeData));
    event.dataTransfer.effectAllowed = 'move';
  };

  const handleAddNode = (nodeType: string, nodeData: any) => {
    onAddNode(nodeType, nodeData);
  };

  const BlockItem = ({ block, category }: { block: any; category: string }) => (
    <div
      className="p-3 border rounded-lg cursor-move hover:shadow-md transition-shadow bg-white"
      draggable
      onDragStart={(e) => handleDragStart(e, block.type, block)}
      onClick={() => handleAddNode(block.type, block)}
      title={`Drag to canvas or click to add: ${block.description}`}
    >
      <div className="flex items-center gap-2 mb-2">
        <span className="text-lg">{block.icon}</span>
        <span className="font-medium text-sm">{block.title}</span>
      </div>
      <p className="text-xs text-gray-600 mb-2">{block.description}</p>
      <div className="text-xs bg-gray-100 px-2 py-1 rounded">
        {category}
      </div>
    </div>
  );

  return (
    <div className="w-80 bg-white border-r border-gray-200 flex flex-col h-full overflow-hidden">
      <div className="p-4 border-b">
        <h3 className="text-lg font-semibold">Workflow Blocks</h3>
        <p className="text-sm text-gray-600">Drag blocks to the canvas to build your workflow</p>
      </div>
      
      <div className="flex-1 overflow-y-auto p-4 space-y-6">
        {/* Triggers Section */}
        <div>
          <h4 className="font-medium text-green-700 mb-3 flex items-center gap-2">
            <span>⚡</span> Triggers
          </h4>
          <div className="space-y-3">
            {workflowBlocks.triggers.map(block => (
              <BlockItem key={block.id} block={block} category="Trigger" />
            ))}
          </div>
        </div>

        {/* AI Agents Section */}
        <div>
          <h4 className="font-medium text-purple-700 mb-3 flex items-center gap-2">
            <span>🤖</span> AI Agents
          </h4>
          <div className="space-y-3">
            {workflowBlocks.aiAgents.map(block => (
              <BlockItem key={block.id} block={block} category="AI Agent" />
            ))}
          </div>
        </div>

        {/* Actions Section */}
        <div>
          <h4 className="font-medium text-blue-700 mb-3 flex items-center gap-2">
            <span>⚙️</span> Actions
          </h4>
          <div className="space-y-3">
            {workflowBlocks.actions.map(block => (
              <BlockItem key={block.id} block={block} category="Action" />
            ))}
          </div>
        </div>

        {/* Conditions Section */}
        <div>
          <h4 className="font-medium text-yellow-700 mb-3 flex items-center gap-2">
            <span>❓</span> Conditions
          </h4>
          <div className="space-y-3">
            {workflowBlocks.conditions.map(block => (
              <BlockItem key={block.id} block={block} category="Condition" />
            ))}
          </div>
        </div>

        {/* Notifications Section */}
        <div>
          <h4 className="font-medium text-pink-700 mb-3 flex items-center gap-2">
            <span>📧</span> Notifications
          </h4>
          <div className="space-y-3">
            {workflowBlocks.notifications.map(block => (
              <BlockItem key={block.id} block={block} category="Notification" />
            ))}
          </div>
        </div>
      </div>

      {/* Quick Actions */}
      <div className="p-4 border-t bg-gray-50">
        <h4 className="font-medium mb-3">Quick Add</h4>
        <div className="grid grid-cols-2 gap-2">
          <Button
            size="sm"
            variant="outline"
            onClick={() => handleAddNode('trigger', workflowBlocks.triggers[0])}
            className="text-xs"
          >
            ⚡ Trigger
          </Button>
          <Button
            size="sm"
            variant="outline"
            onClick={() => handleAddNode('aiAgent', workflowBlocks.aiAgents[0])}
            className="text-xs"
          >
            🤖 AI Agent
          </Button>
          <Button
            size="sm"
            variant="outline"
            onClick={() => handleAddNode('action', workflowBlocks.actions[0])}
            className="text-xs"
          >
            ⚙️ Action
          </Button>
          <Button
            size="sm"
            variant="outline"
            onClick={() => handleAddNode('condition', workflowBlocks.conditions[0])}
            className="text-xs"
          >
            ❓ Condition
          </Button>
        </div>
      </div>
    </div>
  );
}

export default WorkflowSidebar;
