        config: { 
          analysisTypes: ['regulatory-compliance', 'policy-adherence', 'risk-identification'],
          scope: 'all-documents',
          confidence: 0.92 
        },
        position: { x: 250, y: 150 },
        connections: ['data-comp-1']
      },
      {
        id: 'data-comp-1',
        type: 'data-transform',
        title: 'Compliance Report Generation',
        description: 'Generate comprehensive compliance report',
        config: { 
          reportType: 'compliance-audit',
          format: 'PDF',
