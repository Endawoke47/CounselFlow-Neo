        <div className="max-w-7xl mx-auto">
          <div className="text-center space-y-8">
            {/* Announcement Badge */}
            <div className="inline-flex items-center gap-2 bg-gradient-to-r from-blue-50 to-purple-50 border border-blue-200 rounded-full px-4 py-2 text-sm font-medium text-blue-700 mb-8 animate-pulse">
              <Sparkles className="w-4 h-4" />
