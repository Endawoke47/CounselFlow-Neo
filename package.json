{
  "name": "counselflow-ultimate",
  "version": "1.0.0",
  "description": "AI-Powered Legal Practice Management System",
  "author": "Endawoke47",
  "license": "PROPRIETARY",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=apps/web\" \"npm run dev --workspace=apps/api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:real": "npm run dev:real --workspace=apps/api",
    "setup": "node -e \"console.log('Use setup-dev.ps1 on Windows or setup-dev.sh on Unix systems')\"",
    "build": "npm run build --workspaces",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test:coverage --workspaces",
    "test:ci": "npm run test:ci --workspaces",
    "test:watch": "npm run test:watch --workspaces",
    "lint": "npm run lint --workspaces",
    "lint:fix": "npm run lint:fix --workspaces",
    "format": "npm run format --workspaces",
    "format:check": "npm run format:check --workspaces",
    "type-check": "npm run type-check --workspaces",
    "type-coverage": "npm run type-coverage --workspaces",
    "clean": "npm run clean --workspaces",
    "prebuild": "npm run clean",
    "precommit": "npm run lint && npm run type-check && npm run test",
    "docker:build": "docker-compose -f docker-compose.prod.yml build",
    "docker:dev": "docker-compose up --build",
    "docker:staging": "docker-compose -f docker-compose.staging.yml up --build",
    "health-check": "concurrently \"npm run health-check --workspace=apps/web\" \"npm run health-check --workspace=apps/api\"",
    "reset": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && npm install",
    "reset:win": "powershell -Command \"Remove-Item -Recurse -Force node_modules, apps/*/node_modules, packages/*/node_modules -ErrorAction SilentlyContinue; npm install\"",
    "db:reset": "cd apps/api && npx prisma migrate reset --force && cd ../..",
    "db:seed": "cd apps/api && npx prisma db seed && cd ../..",
    "db:studio": "cd apps/api && npx prisma studio && cd ../..",
    "typecheck": "turbo run type-check",
    "typecheck:fix": "npm run typecheck --workspaces --if-present && npm run lint:fix",
    "security:audit": "npm audit --audit-level moderate",
    "security:fix": "npm audit fix",
    "deploy": "docker-compose up -d",
    "deploy:staging": "docker-compose -f docker-compose.staging.yml up -d",
    "deploy:prod": "docker-compose -f docker-compose.prod.yml up -d",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t counselflow-api .",
    "docker:build:web": "docker build -f apps/web/Dockerfile -t counselflow-web .",
    "prisma:generate": "npm run prisma:generate --workspace=apps/api",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/api",
    "prisma:studio": "npm run prisma:studio --workspace=apps/api",
    "prisma:seed": "npm run prisma:seed --workspace=apps/api"
  },
  "devDependencies": {
    "@turbo/gen": "^1.10.12",
    "@types/eslint": "^8.56.2",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "prettier": "^3.2.4",
    "turbo": "^1.10.12",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  },
  "dependencies": {
    "@nestjs/platform-express": "^11.1.3",
    "@types/multer": "^2.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "axios": "^1.10.0",
    "chart.js": "^4.5.0",
    "multer": "^2.0.1",
    "openai": "^5.9.0",
    "qrcode": "^1.5.4",
    "react-chartjs-2": "^5.3.0",
    "speakeasy": "^2.0.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  }
}
