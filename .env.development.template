# CounselFlow Ultimate - Development Environment Template
# Copy this file to .env.development for local development

# ==============================================
# 🔧 APPLICATION CONFIGURATION
# ==============================================
NODE_ENV=development
PORT=3005
APP_URL=http://localhost:3000
API_URL=http://localhost:3005

# ==============================================
# 🔐 SECURITY & AUTHENTICATION
# ==============================================
JWT_SECRET=counselflow-dev-jwt-secret-key-2024-development
JWT_REFRESH_SECRET=counselflow-dev-refresh-secret-key-2024-development
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ==============================================
# 🗄️ DATABASE CONFIGURATION
# ==============================================
# SQLite for development (no setup required)
DATABASE_URL=sqlite:./prisma/dev.db

# For testing with PostgreSQL/MySQL locally:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/counselflow_dev
# DATABASE_URL=mysql://root:password@localhost:3306/counselflow_dev

# ==============================================
# 📧 EMAIL SERVICE CONFIGURATION (Optional in Dev)
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-dev-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=CounselFlow Dev <dev@counselflow.local>

# ==============================================
# 🔄 REDIS CONFIGURATION (Optional in Dev)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=  # Usually no password for local Redis

# ==============================================
# 🤖 AI SERVICES (Development)
# ==============================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-development-openai-api-key
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_MAX_TOKENS=2000

# Local Ollama (Recommended for development)
OLLAMA_URL=http://localhost:11434

# ==============================================
# 💳 PAYMENT PROCESSING (Test Mode)
# ==============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_key
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key

# ==============================================
# ☁️ CLOUD STORAGE (Development)
# ==============================================
# For development, use local storage or development bucket
AWS_ACCESS_KEY_ID=your-dev-aws-access-key
AWS_SECRET_ACCESS_KEY=your-dev-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=counselflow-documents-dev

# ==============================================
# 📱 COMMUNICATION SERVICES (Development)
# ==============================================
# Twilio Test Credentials
TWILIO_ACCOUNT_SID=your-twilio-test-sid
TWILIO_AUTH_TOKEN=your-twilio-test-token
TWILIO_PHONE_NUMBER=+15005550006

# ==============================================
# 📊 MONITORING & ANALYTICS (Optional in Dev)
# ==============================================
# Sentry (optional for development)
# SENTRY_DSN=https://your-dev-sentry-dsn@sentry.io/project-id

# ==============================================
# 🛡️ RATE LIMITING & SECURITY
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGIN=http://localhost:3000

# ==============================================
# 📝 LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=debug
LOG_DIR=./logs
ENABLE_REQUEST_LOGGING=true
LOG_FORMAT=combined
LOG_MAX_FILES=5
LOG_MAX_SIZE=5m

# ==============================================
# 🎛️ FEATURE FLAGS (Development)
# ==============================================
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=false
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_API_DOCS=true
ENABLE_HEALTH_CHECKS=true
SWAGGER_ENABLED=true
DEBUG_MODE=true

# ==============================================
# 🔧 PERFORMANCE TUNING
# ==============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
REQUEST_TIMEOUT=30000
COMPRESSION_LEVEL=3

# ==============================================
# 🧪 DEVELOPMENT TOOLS
# ==============================================
# Hot Reload
WATCH_FILES=true
AUTO_RESTART=true

# Development Database Seeding
SEED_DATABASE=true
CREATE_MOCK_DATA=true

# API Documentation
SWAGGER_UI_ENABLED=true
API_DOCS_PATH=/api-docs
