# CounselFlow Ultimate - Production Environment Template
# Copy this file to .env.production and fill in the actual values

# ==============================================
# 🔧 APPLICATION CONFIGURATION
# ==============================================
NODE_ENV=production
PORT=3005
APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com

# ==============================================
# 🔐 SECURITY & AUTHENTICATION
# ==============================================
JWT_SECRET=your-super-secure-jwt-secret-key-256-bits-minimum
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-256-bits-minimum
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
PASSWORD_RESET_TOKEN_EXPIRES_IN=1h

# ==============================================
# 🗄️ DATABASE CONFIGURATION
# ==============================================
# For production, use PostgreSQL or MySQL
DATABASE_URL=postgresql://username:password@localhost:5432/counselflow
# Alternative for MySQL: mysql://username:password@localhost:3306/counselflow

# ==============================================
# 📧 EMAIL SERVICE CONFIGURATION
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-app-email@domain.com
SMTP_PASS=your-app-password-or-api-key
EMAIL_FROM=CounselFlow <noreply@your-domain.com>

# ==============================================
# 🔄 REDIS CONFIGURATION (Caching & Sessions)
# ==============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_URL=redis://username:password@localhost:6379

# ==============================================
# 🤖 AI SERVICES
# ==============================================
# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=4000

# Anthropic Configuration
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet

# Google AI Configuration
GOOGLE_API_KEY=your-google-ai-api-key

# Local Ollama (Optional)
OLLAMA_URL=http://localhost:11434

# ==============================================
# 💳 PAYMENT PROCESSING
# ==============================================
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key

# ==============================================
# ☁️ CLOUD STORAGE (AWS S3)
# ==============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=counselflow-documents-prod

# ==============================================
# 📱 COMMUNICATION SERVICES
# ==============================================
# Twilio for SMS/Phone
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# 📊 MONITORING & ANALYTICS
# ==============================================
# Sentry Error Monitoring
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics / Mixpanel
MIXPANEL_TOKEN=your-mixpanel-token
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# ==============================================
# 🛡️ RATE LIMITING & SECURITY
# ==============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=https://your-domain.com

# Security Headers
HELMET_CSP_DIRECTIVES=default-src 'self'; script-src 'self' 'unsafe-inline'
TRUST_PROXY=true

# ==============================================
# 📝 LOGGING CONFIGURATION
# ==============================================
LOG_LEVEL=info
LOG_DIR=./logs
ENABLE_REQUEST_LOGGING=true
LOG_FORMAT=json
LOG_MAX_FILES=10
LOG_MAX_SIZE=10m

# ==============================================
# 🎛️ FEATURE FLAGS
# ==============================================
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=true
ENABLE_TWO_FACTOR_AUTH=false
ENABLE_API_DOCS=false
ENABLE_HEALTH_CHECKS=true

# ==============================================
# 🔧 PERFORMANCE TUNING
# ==============================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
REQUEST_TIMEOUT=30000
COMPRESSION_LEVEL=6

# ==============================================
# 🧪 THIRD-PARTY INTEGRATIONS
# ==============================================
# Legal Research APIs
WESTLAW_API_KEY=your-westlaw-api-key
LEXISNEXIS_API_KEY=your-lexisnexis-api-key

# Document Processing
DOCUSIGN_CLIENT_ID=your-docusign-client-id
DOCUSIGN_CLIENT_SECRET=your-docusign-client-secret

# Calendar Integration
GOOGLE_CALENDAR_CLIENT_ID=your-google-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-client-secret
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret

# ==============================================
# 🏥 HEALTH CHECK ENDPOINTS
# ==============================================
HEALTH_CHECK_TOKEN=your-health-check-secret-token
METRICS_ENDPOINT_ENABLED=true
STATUS_PAGE_ENABLED=true
